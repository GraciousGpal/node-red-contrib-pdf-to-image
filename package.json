{
  "name": "@graciousstar/node-red-contrib-pdf-to-image",
  "version": "1.0.1",
  "description": "Convert a PDF into PNG/JPEG images (page selection, DPI, rotation). Uses MuPDF compiled to WebAssembly - no native dependencies.",
  "author": "GraciousGpal (https://github.com/GraciousGpal)",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/GraciousGpal/node-red-contrib-pdf-to-image#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GraciousGpal/node-red-contrib-pdf-to-image.git"
  },
  "bugs": {
    "url": "https://github.com/GraciousGpal/node-red-contrib-pdf-to-image/issues"
  },
  "keywords": [
    "node-red",
    "pdf",
    "image",
    "png",
    "jpeg",
    "jpg",
    "convert",
    "render",
    "mupdf"
  ],
  "files": [
    "pdf-to-image.js",
    "pdf-to-image.html",
    "icons/",
    "README.md",
    "LICENSE"
  ],
  "node-red": {
    "version": ">=2.0.0",
    "nodes": {
      "pdf-to-image": "pdf-to-image.js"
    }
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "mupdf": "^1.28.0"
  }
}
